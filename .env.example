# ============================================================
# Variables de entorno — msc-thesis-rlm-evaluation
# Copia este archivo como .env y rellena tus valores
# ============================================================

# APIs
OPENAI_API_KEY=sk-tu-clave-openai-aqui
GOOGLE_API_KEY=tu-clave-gemini-aqui

# Rutas base (notebooks 01 y 02) - Ajusta según la estructura de tu repositorio
BASE_DIR=/content/drive/MyDrive/proyect                                                          # Directorio base del proyecto
CORPUS_PDF_DIR=/content/drive/MyDrive/proyect/corpus/papers                                      # Directorio con los registros del corpus descargados en formato PDF
CORPUS_RAW_DIR=/content/drive/MyDrive/corpus/raw                                                 # Directorio con el texto extraído de los registros sin preprocesar
CORPUS_PROCESSED_DIR=/content/drive/MyDrive/corpus/processed                                     # Directorio con el texto preprocesado de los registros
CORPUS_METADATA_PATH=/content/drive/MyDrive/corpus/metadata/corpus_metadata.csv                  # Directorio con los metadatos de los registros del corpus
CORPUS_REPORTS_DIR=/content/drive/MyDrive/corpus/reports                                         # Directorio con los informes de extracción y preprocesamiento

# Rutas base (notebook 03) - Ajusta según la estructura de tu repositorio
QUERIES_PATH=/content/drive/MyDrive/Colab Notebooks/UTAMED/TFM/queries/queries.json              # Directorio con el archivo JSON con las consultas
RESULTS_DIR=/content/drive/MyDrive/Colab Notebooks/UTAMED/TFM/experiments/results                # Directorio con los resultados de las ejecuciones del sistema experimental
RLM_LOGS_DIR=/content/drive/MyDrive/Colab Notebooks/UTAMED/TFM/experiments/rlm_logs              # Directorio con los registros de las trayectorias de razonamiento de los RLM
CHROMA_DIR=/content/drive/MyDrive/Colab Notebooks/UTAMED/TFM/experiments/rag/chroma_index        # Directorio con el índice vectorial de ChomaDB para el sistema RAG
